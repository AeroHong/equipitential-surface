rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        (
          // 기본 권한 모델: Firestore users 문서의 관리자 역할
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          // Storage 최초 운영 계정: Firebase Auth 이메일로도 명시 허용
          request.auth.token.email == 'hckgood@seonyoo.hs.kr'
        );
    }

    function isTeacher() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // 지문 이미지 — services/storage.js의 uploadPassageImage()가 essayPassages/{uid}/...
    // 경로로 올린다(uid = 업로드하는 본인). 예전엔 write가 isAdmin()(super_admin 전용)만
    // 허용해서, 일반 teacher 계정으로 지문을 만들 때 이미지 업로드가 storage/unauthorized로
    // 항상 실패하는 버그가 있었다 — Firestore의 essayPassages 생성 권한(isEssayStaff() &&
    // createdBy==본인, firestore.rules)과 같은 모델로 맞춘다: 본인 uid 경로 + teacher
    // 역할이면 허용, admin은 전체 허용.
    match /essayPassages/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if (isAdmin() || (isTeacher() && request.auth.uid == uid)) &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // 학생 답안에 끼워 넣는 이미지 — 지문과 달리 "작성자 = 그 학생 본인"이라 교사 승인
    // 없이도 본인 경로에만 쓸 수 있게 한다. 경로의 uid가 본인 것인지, 이미지 파일인지,
    // 20MB(services/storage.js의 MAX_IMAGE_BYTES)를 넘지 않는지를 규칙에서도 강제해서
    // 클라이언트 쪽 체크를 devtools로 우회해도 서버 쪽에서 막히게 한다.
    match /essayAnswers/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid &&
        request.resource.size < 20 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
