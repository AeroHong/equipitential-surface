# Google Classroom 연동(services/classroom.js)에 필요한 OAuth 클라이언트 ID.
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서
# "OAuth 클라이언트 ID"(웹 애플리케이션)를 발급받아 입력하세요.
# Client Secret은 필요 없습니다 (클라이언트 전용 OAuth 흐름).
#
# 사용법: 이 파일을 .env.local로 복사한 뒤 값을 채우세요. .env.local은 git에 커밋되지 않습니다.
VITE_GOOGLE_CLIENT_ID=

# 실시간 접속/입력 현황(presence)에 필요한 Realtime Database 주소.
# Firebase 콘솔 > Realtime Database > 데이터베이스 만들기 로 인스턴스를 생성하면
# 상단에 표시되는 주소(예: https://<project-id>-default-rtdb.<region>.firebasedatabase.app)를
# 그대로 붙여넣으세요. 비워두면 계산기/과제 기능은 그대로 동작하고 presence 기능만 꺼집니다.
VITE_FIREBASE_DATABASE_URL=
